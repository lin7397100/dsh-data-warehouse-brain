# 数仓智脑专家团 · 凭据模板
# 用法：复制本文件到 $DSH_HOME/.env（Windows: %USERPROFILE%\.dsh\.env；Linux: ~/.dsh/.env）
#      然后按 docs/AUTH-SETUP.md 填值。不要提交填写后的 .env 到任何仓库。
# 一键：python scripts/write_env.py --set KEY=VALUE ...（自动备份/合并/脱敏）
# 查看：python scripts/write_env.py --status

# ── 1. EPLAT 5sApi（内网 eplat.fjsg.com/service/*）──────────────────────────
# 日成本域过程日志（默认 clientId: sgdw-cb01）
EPLAT_CLIENT_ID_CB01=sgdw-cb01
EPLAT_CLIENT_SECRET_CB01=
# 管控抽数 ETL 日志（默认 clientId: sgdw-cs01）
EPLAT_CLIENT_ID_CS01=sgdw-cs01
EPLAT_CLIENT_SECRET_CS01=
# 早会 PPT 报表（默认 clientId: sgdw-gz01）
EPLAT_CLIENT_ID_GZ01=sgdw-gz01
EPLAT_CLIENT_SECRET_GZ01=

# ── 2. 企微（私有化 wecom.fjsg.com.cn）─────────────────────────────────────
# 每日点检 token 应用（给报表/ETL 接口换 token）
WECOM_TOKEN_CLIENT_ID=sgoc-oc01
WECOM_TOKEN_CLIENT_SECRET=
# 智能表格 / 自建应用
WECOM_CORPID=
WECOM_CORPSECRET=
# 目标文档（选填）
WECOM_DOCID=

# ── 3. DB2 通道 ────────────────────────────────────────────────────────────
# 优先用 DB2 MCP；无 MCP 时走 5sApi REST 桥接（下面三项）
SGDW_LIGHTCODE_TOKEN=
SGDW_USER_ID=230012
SGDW_CLIENT_ID=sgdw-sc01
# DB2 MCP（若由 MCP 客户端直连，按运维给的地址填）
SG_DB2_MCP_URL=

# ── 4. MCP 服务与开关 ──────────────────────────────────────────────────────
# 内网 MCP 总开关：1=启用（默认关闭，公网用户不要开）
DWB_INTERNAL_MCP=1
# 总体急停：off = 关闭全部 MCP 客户端
SG_MCP=
# EPLAT 设计态（Oracle 只读）
SG_EPLAT_MCP_URL=http://10.18.136.38:8770/mcp
# WeKnora 知识库
SG_WEKNORA_MCP_URL=http://10.233.2.32:9080/mcp
SG_WEKNORA_TOKEN=

# ── 5. 报表服务 ────────────────────────────────────────────────────────────
# 帆软 FineReport（管制/生产/ERP 报表）
FINEREPORT_URL=http://172.16.100.25:8080/webroot/decision/view/report
# CBMS 成本报表（如与上面不是同一服务）
CBMS_URL=

# ── 6. 可选：图谱 / 向量库 / 小模型 ────────────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
JEV_URL=http://10.233.2.32:11434/v1/systemone

# ── 7. 运行时（一般不用改）─────────────────────────────────────────────────
# 指定 Python 解释器（面板回写/团队脚本用）
DSH_PYTHON=
