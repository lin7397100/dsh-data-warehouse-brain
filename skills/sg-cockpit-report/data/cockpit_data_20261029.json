      "sql": "-- 钢材日产量 / 月累计（按 ZB_CODE 取数；FACTORY_DIV 存产线组合串，禁按厂别过滤）\nSELECT YMD, ZB_CODE, ZB_VALUE\nFROM SMBB_M_S_ZZ00.T_DWS_FACT_ZZGZ_0002\nWHERE YMD = '20261029'\n  AND ZB_CODE IN ('1600014','1600057','1600058','1600026','1600061','1600062');\n\n-- 粗钢日产量（FACTORY_DIV: 11+12=本部, 13=泉州, 14=罗源）\nSELECT FACTORY_DIV, ZB_CODE, ZB_VALUE\nFROM SMBB_M_S_ZZ00.T_DWS_FACT_ZZGZ_0003\nWHERE YMD = '20261029' AND FACTORY_DIV IN ('11+12','13','14');\n\n-- 钢铁料耗 / 铁水耗（列名 YMD + FACTORY_CODE 常空，用 FACTORY_CNAME 区分）\nSELECT YMD, FACTORY_CNAME, ZB_CODE, ZB_VALUE\nFROM SMBB_M_S_ZZ00.T_DWS_FACT_ZZGZ_LG01\nWHERE YMD = '20261029'\n  AND (ZB_NAME LIKE '%钢铁料耗%' OR ZB_NAME LIKE '%铁水耗%');",
      "pitfall": "T_DWS_FACT_ZZGZ_0002 的 FACTORY_DIV 是产线组合字符串（如 21+22+23+51+52+31日），按厂别过滤会跨基地混数"
