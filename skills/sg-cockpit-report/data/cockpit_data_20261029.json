      "sql": "-- 吨材成本（日）\nSELECT ACCOUNT_PERIOD, DAY_ALL_VAL\nFROM SMBB_M_A_CB01.T_ADS_SRV_CACA_DAY_COST\nWHERE ITEM_NAME2 = '吨材成本' AND ITEM_UNIC = '元/吨'\n  AND ACCOUNT_PERIOD BETWEEN '20261016V1' AND '20261029V1'\nORDER BY ACCOUNT_PERIOD;\n\n-- 吨材成本（月，CBCX06 = 6.钢材）\nSELECT ACCOUNT_PERIOD, MONTH_CONSUME, MONTH_COST,\n       MONTH_COST / NULLIF(MONTH_CONSUME,0) AS UNIT_COST\nFROM SMBB_M_A_CB01.T_ADS_SRV_CACA_MAIN_COST\nWHERE ITEM_CODE = 'CBCX06'\n  AND ACCOUNT_PERIOD BETWEEN '202604' AND '202609';",
